<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the device: the config store holds SMB credentials encrypted with a
   Keystore key that a restored copy could not use anyway, and the ancestor database
   only makes sense next to the exact files it was built from.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
